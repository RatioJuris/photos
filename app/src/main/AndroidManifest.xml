<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13+: photos and videos (no audio). Android 14+: partial "selected photos and videos" access. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Unredacted GPS in photos, for Details and Places. Read on the device only. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- Used only for map images, and only after the user turns Maps on. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 12 / 12L (and the API 29 device-test build). -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".RatioJurisPhotosApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:hasFragileUserData="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Photos"
        tools:targetApi="36">

        <activity
            android:name=".ui.RatioJurisMainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Opens files handed over by file managers, messengers, e-mail, other galleries and the Sharesheet. -->
        <activity
            android:name=".ui.RatioJurisOpenActivity"
            android:exported="true"
            android:label="@string/open_with_label"
            android:taskAffinity="io.github.ratiojuris.photos.open"
            android:excludeFromRecents="false"
            android:windowSoftInputMode="adjustResize">

            <!-- Protected photos with our MIME type, and ordinary images. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.photos.phtx" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <!-- .phtx files labelled as generic binary by the sending app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.phtx" />
                <data android:pathPattern=".*\\..*\\.phtx" />
                <data android:pathPattern=".*\\..*\\..*\\.phtx" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.phtx" />
            </intent-filter>

            <!-- .phtx files sent without any MIME type. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.phtx" />
                <data android:pathPattern=".*\\..*\\.phtx" />
                <data android:pathPattern=".*\\..*\\..*\\.phtx" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.phtx" />
            </intent-filter>

            <!-- Sharesheet: receive a protected file or a photo. Content is validated, never trusted by type. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.photos.phtx" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
